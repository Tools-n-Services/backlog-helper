# Локальный Postgres поднимается из пакета embedded-postgres в .data/pg —
# ни Docker, ни установленная в систему СУБД не нужны: pnpm db:up.
# В проде здесь адрес управляемого Postgres, и команды db:* не нужны —
# код приложения и миграции те же.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backlog_helper

# Куда уходят письма.
#   file   — в .data/mail (по умолчанию): вход по ссылке работает
#            на свежем клоне без единого внешнего сервиса
#   log    — только в консоль сервера
#   resend — настоящая доставка, нужен RESEND_API_KEY
MAIL_PROVIDER=file
# MAIL_FROM="Ритмика <no-reply@ritmika.app>"
# RESEND_API_KEY=

# Вложения обращений (FR-512) — хранилище пока не подключено.
# S3_ENDPOINT=
# S3_BUCKET=
