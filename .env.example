# Локальный Postgres поднимается из пакета embedded-postgres в .data/pg —
# ни Docker, ни установленная в систему СУБД не нужны: pnpm db:up.
# В проде здесь адрес управляемого Postgres, и команды db:* не нужны —
# код приложения и миграции те же.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backlog_helper

# Адрес портала. Он попадает в ссылки внутри писем — по ним человек
# и возвращается, поэтому без него доставка бессмысленна: письмо дойдёт,
# а ссылка в нём приведёт в пустоту. Без переменной берётся домен из
# config/product.ts, что верно только для настоящего развёртывания.
PORTAL_ORIGIN=http://localhost:3000

# Куда уходят письма.
#   file   — в .data/mail (по умолчанию): вход по ссылке работает
#            на свежем клоне без единого внешнего сервиса
#   log    — только в консоль сервера
#   smtp      — настоящая доставка через почтовый сервер организации
#   unisender — Unisender Go: российский сервис, оплата в рублях
#   resend    — доставка через HTTP-API, если SMTP закрыт наружу
#
# Настройку канала проверяет pnpm mail:check — он же отправляет
# пробное письмо: pnpm mail:check you@example.com
MAIL_PROVIDER=file

# Отправитель. При smtp по умолчанию берётся SMTP_USER: почтовые серверы
# отвергают письма, в которых From не совпадает с ящиком подключения.
# MAIL_FROM="Ритмика <feedback@example.com>"

# SMTP. Порт 587 со STARTTLS — то, что отдают Яндекс 360 и Mail.ru
# для бизнеса; 465 означает TLS с первого байта (SMTP_SECURE=1).
# SMTP_USER без SMTP_PASSWORD — ошибка, а не релей без входа.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=587
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASSWORD=

# Unisender Go. Домен отправителя должен быть подтверждён в панели сервиса —
# иначе письма отвергаются, и это самая частая причина отказа на старте.
# Ключ уходит HTTP-заголовком: кириллическая буква в нём (на русской
# раскладке «с» и «c» неотличимы) даёт отказ с понятным объяснением.
# UNISENDER_API_KEY=
# UNISENDER_API_URL=            # go2.unisender.ru — европейская площадка
# UNISENDER_SKIP_UNSUBSCRIBE=   # 1 — не давать сервису дописывать свою
                                # ссылку отписки; требует разрешения поддержки

# Resend. onboarding@resend.dev — общий отправитель сервиса: работает без
# подтверждения домена, но письма уходят ТОЛЬКО на адрес владельца аккаунта.
# Для рассылки подписчикам нужен свой подтверждённый домен.
# RESEND_API_KEY=
# RESEND_API_URL=   # переопределение адреса API; нужно тестам и прокси

# Вложения обращений (FR-512).
#   file (по умолчанию) — каталог .data/uploads: свежий клон работает
#                         без единого внешнего сервиса
#   s3                  — любое S3-совместимое хранилище: MinIO, Yandex, AWS
#
# Отдаёт файл всегда приложение, а не хранилище: публичный бакет не умеет
# отличить команду от постороннего, а вложения бага по умолчанию team_only.
# Значит, бакет должен быть закрытым.
STORAGE_PROVIDER=file
# S3_ENDPOINT=            # https://storage.yandexcloud.net, http://minio:9000
# S3_BUCKET=
# S3_REGION=              # участвует в подписи; по умолчанию us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
