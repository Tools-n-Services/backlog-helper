# Раздача лендинга (Railway).
#
# Порт приходит переменной: платформа назначает его сама и меняет между
# перезапусками. Значение по умолчанию — 8000, потому что именно его Railway
# подставляет домену, когда не смог определить порт сам: контейнер слушал 80,
# домен вёл на 8000, и наружу это выглядело как «приложение не отвечает».
:{$PORT:8000} {
	root * /srv
	file_server
	encode zstd gzip

	# Документы отдаются текстом, а не файлом на скачивание: их открывают
	# по ссылке со страницы и читают тут же.
	@markdown path *.md
	header @markdown Content-Type "text/plain; charset=utf-8"

	# Страница одна, и адрес у неё один: любой другой путь ведёт на неё же,
	# а не на пустой экран сервера.
	try_files {path} /index.html
}
