# Раздача лендинга (Railway).
#
# Слушаем сразу оба порта, и это не перестраховка. Railway не передаёт этому
# сервису переменную PORT, а целевой порт домена задаётся в панели: сначала
# он был 8000 при контейнере на 80, потом 80 при контейнере на 8000 — и оба
# раза наружу это выглядело как «приложение не отвечает», хотя приложение
# работало. Два адреса закрывают оба варианта, и настройка домена перестаёт
# что-либо ломать.
:80, :8000 {
	root * /srv
	file_server
	encode zstd gzip

	# Инструкции отдаются текстом, а не файлом на скачивание: их открывают
	# по кнопке со страницы и читают тут же.
	@markdown path *.md
	header @markdown Content-Type "text/plain; charset=utf-8"

	# Языковые версии лежат каталогами: /en/ и /es/ должны открываться
	# без имени файла.
	try_files {path} {path}/index.html /index.html
}
