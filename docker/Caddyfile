# Обратный прокси портала (В6, docs/09-install.md).
#
# Домен приходит переменной: один и тот же файл обслуживает любой продукт,
# и менять при копировании нужно только .env.
{$PORTAL_DOMAIN} {
	encode zstd gzip

	# Загрузка видео к багрепорту — до 50 МБ (config/attachments.ts).
	# Умолчание прокси отвергло бы её раньше, чем приложение объяснит причину.
	request_body {
		max_size 64MB
	}

	reverse_proxy app:3000 {
		# Next приводит адрес перенаправления к тому, по которому знает себя
		# сам, — а знает он себя по внутреннему `0.0.0.0:3000`, на который
		# снаружи не попасть. Срезаем этот адрес: относительный Location
		# браузер разрешит относительно настоящего домена.
		#
		# Чинится здесь, а не в приложении: публичный адрес знает прокси,
		# приложение — нет, и знать не должно.
		header_down Location "^https?://0\.0\.0\.0:3000" ""
	}
}
